#include <cuda_runtime.h>

#define tilesize 32
#define dtilesize 64
#define ttilesize 96
#define qtilesize 128

//we implement 4-element 1D register tiling in order to compute 4 elements per thread. 

__global__ void GEMM(const float* A, const float* B, float* C, int M, int N, int K, float alpha, float beta) {
    int col = qtilesize * blockIdx.x + threadIdx.x; //need to do 64 apart now
    int row = blockDim.y * blockIdx.y + threadIdx.y;

    __shared__ float Atile[tilesize][tilesize], Btile[tilesize][qtilesize]; //allocate 128 columns for B so we can compute 2 elements per thread


    float sum1 = 0.0f;
    float sum2 = 0.0f;
    float sum3 = 0.0f;
    float sum4 = 0.0f;
    //iterate tile along shared dim K
    for (int tile = 0; tile < (K + tilesize - 1)/tilesize; tile++) {
        int tilecolA = tile * tilesize + threadIdx.x;
        int tilerowB = tile * tilesize + threadIdx.y;
        Atile[threadIdx.y][threadIdx.x] = (row < M && tilecolA < K) ? A[row * K + tilecolA] : 0.0f;
        Btile[threadIdx.y][threadIdx.x] = (tilerowB < K && col < N) ? B[tilerowB * N + col] : 0.0f;
        //was considering hoisting out col + tilesize and threadIdx.x + tilesize but I decided the compiler would do it anyway so probably doesnt matter
        //relying on -O3 to do my legwork lol
        Btile[threadIdx.y][threadIdx.x+tilesize] = (tilerowB < K && col+tilesize < N) ? B[tilerowB * N + col+tilesize] : 0.0f;
        Btile[threadIdx.y][threadIdx.x+ dtilesize] = (tilerowB < K && col+dtilesize < N) ? B[tilerowB * N + col+ dtilesize] : 0.0f;
        Btile[threadIdx.y][threadIdx.x+ ttilesize] = (tilerowB < K && col+ttilesize < N) ? B[tilerowB * N + col+ ttilesize] : 0.0f;
        __syncthreads();

        for (int p = 0; p < tilesize; p++) {
            float A_reuse = Atile[threadIdx.y][p]; //not REALLY necessary because compiler will do this anyway, but wanted to show what the point was of this
            sum1 += A_reuse * Btile[p][threadIdx.x];
            sum2 += A_reuse * Btile[p][threadIdx.x + tilesize];
            sum3 += A_reuse * Btile[p][threadIdx.x + dtilesize];
            sum4 += A_reuse * Btile[p][threadIdx.x + ttilesize];

        }
        
        __syncthreads();
    }

    if (M > row) {
        if (N > col)
            C[row * N + col] = alpha * sum1 + beta * C[row * N + col];
        if (N > col+tilesize)
            C[row * N + col+tilesize] = alpha * sum2 + beta * C[row * N + col+tilesize];
        if (N > col+dtilesize)
            C[row * N + col+dtilesize] = alpha * sum3 + beta * C[row * N + col+dtilesize];
        if (N > col+ttilesize)
            C[row * N + col+ttilesize] = alpha * sum4 + beta * C[row * N + col+ttilesize];
    }

}

extern "C" cudaError_t launchGEMM(const float* A, const float* B, float* C,
                                   int M, int N, int K, float alpha, float beta) {
    dim3 threads(tilesize, tilesize);
    dim3 blocks((N + qtilesize - 1) / qtilesize, //columns are spaced by qtilesize now, so only launch appropriate block numbers. 
                (M + tilesize - 1) / threads.y);
    GEMM<<<blocks, threads>>>(A, B, C, M, N, K, alpha, beta);
    return cudaGetLastError();
}

